# Compat with older peer-dep declarations across many deps
legacy-peer-deps=true

# Silence "82 vulnerabilities" summary at end of `npm install`.
# Our security-scan.cjs runs a real check via .audit-allowlist.json;
# npm's raw output is duplicated noise.
audit=false

# "1234 packages are looking for funding" spam.
fund=false

# npm 11 install-scripts warnings — package ecosystem hasn't
# converged on a config surface yet, and the warnings duplicate what
# security-scan.cjs already covers via the audit allowlist. Drop to
# error-level so npm's own warn stream stops noise-bombing the build.
loglevel=error
