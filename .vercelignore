# Vercel Ignore File
# Files and folders to exclude from deployment

# Large media files
Investors/
docs/demo-videos/
*.mp4
*.mov
*.avi
*.mkv
*.m4a
*.mp3
*.wav
*.webm

# Development files
.git/
.github/
node_modules/
.next/
.vercel/
test/
tests/
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Non-Next artefacts (1.1GB+ of Rust/Move/build stuff Vercel doesn't need)
substreams/
zkp-rust/
contracts/sui/
contracts/core/
contracts/mocks/
contracts/helpers/
graphify-out/
.memsearch/

# Build artifacts
artifacts/
cache/
typechain-types/
.openzeppelin/
coverage/

# Python ZK backend (separate deployment)
zkp/

# Fine-tuned model artifacts (served from WSL/GPU host, not Vercel).
# The whole training/ tree is dev-only — training data + adapters +
# merged weights. 15 GB+ if included; Vercel deploy fails at ~14.3 GB.
# Runtime uses SIGNAL_INTERPRETER_MODEL_URL (Cloudflare Tunnel to GPU).
training/
data/signal-interpreter/
scripts/ai-training/
scripts/_*
# Belt-and-suspenders — catch stray safetensors anywhere in the tree
**/*.safetensors
**/output-v*/
**/merged/

# Hardhat
hardhat.config.cjs
tsconfig.hardhat.json

# Logs
logs/
*.log

# Documentation (not needed in deployment)
# Anchor to root only — un-anchored `docs/` would also strip app/[locale]/docs/
/docs/
*.md
!README.md
!content/*.md

# Local env files
.env.local
.env.development
.env.prod.full

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
